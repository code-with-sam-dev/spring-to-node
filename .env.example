# Copy to .env and change anything that collides on your machine:
#
#     cp .env.example .env
#
# Docker Compose reads .env automatically, so after that plain
# `docker compose up` works and you never have to remember these again.
#
# WHY THIS FILE EXISTS. The defaults below are the documented ones and they are
# correct. They are also the three most contended ports on a developer laptop:
#   3000  every Next.js and React dev server
#   8080  every other Java service you have ever run
#   5432  a local PostgreSQL, which most Java developers already have
# All three collided on the machine this repository was built on.

NEST_PORT=3000
SPRING_PORT=8080
POSTGRES_PORT=5432
